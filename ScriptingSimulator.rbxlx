	"Rooftop solar panels power the setup.",
	"RGB ceiling ring and grand pillars.",
	"Roof antenna tower and satellite dish.",
	"Glass facade, golden trim and a helipad!",
}
Config.House = {}
for i = 1, 10 do
	Config.House[i] = {
		level = i, name = HOUSE_NAMES[i], mult = HOUSE_MULT[i], slots = HOUSE_SLOTS[i], perk = HOUSE_PERKS[i],
		price = (i == 1) and 0 or nice(2500 * 5.5 ^ (i - 2)),
	}
end

----------------------------------------------------------------------
