	{ skin = C(120,80,55), shirt = C(180,100,255), pants = C(35,35,45), hat = "glasses" },
	{ skin = C(240,190,150), shirt = C(255,210,70), pants = C(70,60,50), hat = "headphones" },
	{ skin = C(160,105,75), shirt = C(240,90,130), pants = C(45,50,70), hat = "cap" },
