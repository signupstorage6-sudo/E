	{ name = "Split Ergo", layout = "split", case = C(40,42,50), key = C(90,95,110), glow = C(90,255,170), ex = { "wrist" } },
	{ name = "Ortho Pro", layout = "ortho", case = C(30,34,44), key = C(220,70,70), glow = C(255,90,90), ex = {} },
	{ name = "Walnut Artisan", mat = "Wood", layout = "tkl", case = C(110,70,40), key = C(240,225,195), accent = C(190,140,60), ex = { "wrist" } },
	{ name = "Curved Cyber", layout = "curve", case = C(15,25,35), key = C(30,60,80), glow = C(0,230,255), ex = {} },
	{ name = "Holo-Key", layout = "tkl", case = C(200,230,240), key = C(0,255,200), glow = C(0,255,200), glass = true, ex = {} },
	{ name = "Carbon Elite", mat = "Metal", layout = "full", case = C(18,18,20), key = C(40,40,44), accent = C(255,80,60), glow = C(255,80,60), ex = { "wrist" } },
	{ name = "Crystal Switch", layout = "tkl", case = C(190,225,255), key = C(220,240,255), glow = C(140,200,255), glass = true, ex = {} },
