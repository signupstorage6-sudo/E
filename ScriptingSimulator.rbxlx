			<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Challenges</string><ProtectedString name="Source"><![CDATA[-- Challenges.lua  (ReplicatedStorage/Shared)
-- Lines of real Luau that Hardcore mode asks you to type. Harder lines for better computers.
local Challenges = {}

local POOLS = {
	{ -- computers 1-5
		'print("Hello, world!")', 'local x = 10', 'local name = "Bit"', 'x = x + 1', 'print(1 + 2)',
		'local ok = true', 'task.wait(1)', 'print(#"scripting")', 'local y = x * 2',
	},
	{ -- computers 6-10
		'local part = Instance.new("Part")', 'part.Anchored = true', 'part.Parent = workspace',
		'local hp = humanoid.Health', 'print(player.Name)', 'local t = {1, 2, 3}',
		'if hp <= 0 then return end', 'part.Size = Vector3.new(4, 1, 2)',
	},
	{ -- computers 11-15
		'for i = 1, 10 do print(i) end', 'while true do task.wait() end', 'local function add(a, b) return a + b end',
		'table.insert(list, value)', 'part.Touched:Connect(onTouch)', 'local clone = template:Clone()',
		'task.spawn(function() end)', 'for _, v in ipairs(list) do end',
	},
	{ -- computers 16-20
		'game.Players.PlayerAdded:Connect(onJoin)', 'local data = store:GetAsync(key)', 'remote.OnServerEvent:Connect(handle)',
		'TweenService:Create(part, info, goal):Play()', 'local ok, err = pcall(function() end)',
		'RunService.Heartbeat:Connect(function(dt) end)', 'workspace:Raycast(origin, direction)',
	},
}

function Challenges.forTier(computerTier)
	local pool = POOLS[math.clamp(math.ceil(computerTier / 5), 1, #POOLS)]
	return pool[math.random(#pool)]
end

return Challenges
]]></ProtectedString></Properties></Item>
			<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">ComputerModels</string><ProtectedString name="Source"><![CDATA[-- ComputerModels.lua (ReplicatedStorage/Shared) - the 20 computer models.
local CollectionService = game:GetService("CollectionService")
local Config = require(script.Parent.Config)
local Kit = require(script.Parent.ModelKit)

local Models = {}
local P, Cyl, Ball, Ring, screenText, spinGroup, newModel = Kit.P, Kit.Cyl, Kit.Ball, Kit.Ring, Kit.screenText, Kit.spinGroup, Kit.newModel
local C, V, CF = Color3.fromRGB, Vector3.new, CFrame.new
local M = Enum.Material
local rad, pi, cos, sin = math.rad, math.pi, math.cos, math.sin

----------------------------------------------------------------------
-- COMPUTERS
----------------------------------------------------------------------
local DARK = C(22, 24, 30)

local function panel(m, cf, w, h, spec, text, mon)
	P(m, V(w, h, 0.22), cf, DARK, M.SmoothPlastic)
	local scr = P(m, V(w - 0.26, h - 0.26, 0.05), cf * CF(0, 0, 0.12), spec.scr:Lerp(C(0, 0, 0), 0.86), M.Neon, { name = "Screen" })
	if text then screenText(scr, "> " .. text .. "\n> _", spec.scr) end
	return scr
end

local function buildMonitor(m, spec, cx, w, h, mon, first, opts)
	local text = first and spec.code or nil
	local top
	if mon.crt then
		P(m, V(w, h, 2.4), CF(cx, 0.15 + h / 2, -0.4), spec.body, M.SmoothPlastic)
		P(m, V(w - 0.5, h - 0.5, 0.06), CF(cx, 0.15 + h / 2, 0.82), spec.scr:Lerp(C(0, 0, 0), 0.8), M.Neon, { name = "Screen" })
		local scr = m:FindFirstChild("Screen")
		if text and scr then screenText(scr, "> " .. text .. "\n> _", spec.scr) end
		P(m, V(w * 0.9, 0.5, 0.9), CF(cx, 0.25, 0.1), spec.acc, M.SmoothPlastic)
		return 0.15 + h
	end
	local cy = 0.95 + h / 2
	P(m, V(1.5, 0.12, 1.1), CF(cx, 0.06, 0), DARK)
	P(m, V(0.28, 0.95, 0.22), CF(cx, 0.55, -0.1), DARK)
	local scr
	if mon.curve then
		local pw, a = w / 3, rad(14)
		for i = -1, 1 do
			local cf = CF(cx + i * pw * cos(a), cy, math.abs(i) * pw * sin(a)) * CFrame.Angles(0, -i * a, 0)
			local s = panel(m, cf, pw, h, spec, (i == 0) and text or nil, mon)
			if i == 0 then scr = s end
		end
	else
		scr = panel(m, CF(cx, cy, 0), w, h, spec, text, mon)
	end
	-- tiny accent LED on the bezel
	P(m, V(math.min(w * 0.25, 1), 0.05, 0.05), CF(cx, cy - h / 2 + 0.06, 0.13), spec.acc, M.Neon)
	if first and scr and opts.lights then
		local l = Instance.new("PointLight")
		l.Color = spec.scr; l.Range = 9; l.Brightness = 0.7; l.Shadows = false
		l.Parent = scr
	end
	return 0.95 + h
end

local function buildLaptop(m, spec, cx, opts)
	P(m, V(3.8, 0.16, 2.6), CF(cx, 0.08, -0.1), spec.body, M.Metal)
	P(m, V(3.2, 0.05, 1.2), CF(cx, 0.17, -0.45), spec.body:Lerp(C(0, 0, 0), 0.35), M.SmoothPlastic)
	P(m, V(1.2, 0.05, 0.7), CF(cx, 0.17, 0.7), spec.body:Lerp(C(255, 255, 255), 0.15), M.SmoothPlastic)
	local hinge = CF(cx, 0.16, -1.3) * CFrame.Angles(rad(-14), 0, 0)
	P(m, V(3.8, 2.5, 0.12), hinge * CF(0, 1.25, 0), spec.body, M.Metal)
	local scr = P(m, V(3.5, 2.2, 0.05), hinge * CF(0, 1.25, 0.08), spec.scr:Lerp(C(0, 0, 0), 0.86), M.Neon, { name = "Screen" })
	screenText(scr, "> " .. spec.code .. "\n> _", spec.scr)
	if opts.lights then
		local l = Instance.new("PointLight"); l.Color = spec.scr; l.Range = 9; l.Brightness = 0.7; l.Shadows = false; l.Parent = scr
	end
	return 3.7
end

local function buildCase(m, spec, x)
	local kind = spec.case
	if kind == "tower" then
		P(m, V(1.7, 3.4, 2.8), CF(x, 1.7, 0.1), spec.body, M.SmoothPlastic)
		if spec.glass then
			P(m, V(1.4, 3.0, 0.06), CF(x, 1.7, 1.52), C(160, 200, 220), M.Glass, { t = 0.55 })
			for i = 0, 2 do
				Cyl(m, 0.95, 0.12, CF(x, 0.75 + i * 1.0, 1.4) * CFrame.Angles(pi / 2, 0, 0), spec.rgb or spec.acc, M.Neon, { t = 0.15 })
			end
			if spec.liquid then
				Cyl(m, 0.14, 2.6, CF(x - 0.45, 1.7, 1.35), spec.liquid, M.Neon)
				Cyl(m, 0.14, 2.6, CF(x + 0.45, 1.7, 1.35), spec.liquid, M.Neon)
				Cyl(m, 0.5, 0.9, CF(x, 2.9, 1.2), spec.liquid, M.Neon, { t = 0.2 })
			end
		else
			P(m, V(1.3, 2.9, 0.06), CF(x, 1.7, 1.52), spec.body:Lerp(C(0, 0, 0), 0.25))
			for i = 0, 5 do P(m, V(1.1, 0.06, 0.04), CF(x, 0.6 + i * 0.35, 1.56), spec.acc) end
			P(m, V(0.5, 0.18, 0.05), CF(x, 3.1, 1.54), spec.acc)
		end
		P(m, V(0.14, 0.14, 0.05), CF(x + 0.55, 2.95, 1.55), spec.acc, M.Neon)
	elseif kind == "mini" then
		P(m, V(1.8, 0.55, 1.8), CF(x, 0.28, 0), spec.body, M.SmoothPlastic)
		P(m, V(1.6, 0.06, 0.05), CF(x, 0.3, 0.92), spec.acc, M.Neon)
		P(m, V(0.2, 0.2, 0.05), CF(x + 0.6, 0.2, 0.92), spec.acc, M.Neon)
	elseif kind == "rack" then
		P(m, V(1.9, 3.9, 2.3), CF(x, 1.95, 0), spec.body, M.Metal)
		for i = 0, 5 do
			P(m, V(1.7, 0.5, 0.08), CF(x, 0.45 + i * 0.6, 1.17), spec.body:Lerp(C(0, 0, 0), 0.3), M.SmoothPlastic)
			P(m, V(0.12, 0.12, 0.05), CF(x + 0.6, 0.45 + i * 0.6, 1.22), spec.acc, M.Neon)
			P(m, V(0.12, 0.12, 0.05), CF(x + 0.35, 0.45 + i * 0.6, 1.22), (i % 2 == 0) and C(255, 170, 40) or spec.acc, M.Neon)
		end
	elseif kind == "core" then
		Cyl(m, 2.0, 0.4, CF(x, 0.2, 0.2), spec.body, M.Metal)
		Cyl(m, 1.1, 3.6, CF(x, 2.1, 0.2), spec.acc, M.Neon, { t = 0.35 })
		Cyl(m, 0.5, 3.8, CF(x, 2.1, 0.2), C(255, 255, 255), M.Neon, { t = 0.15 })
		Cyl(m, 1.8, 0.3, CF(x, 4.0, 0.2), spec.body, M.Metal)
	end
end

local function buildExtras(m, spec, monX, monW, monTop, caseX, opts)
	for _, ex in ipairs(spec.ex) do
		if ex == "speakers" then
			for _, sx in ipairs({ monX - monW / 2 - 0.7, monX + monW / 2 + 0.7 }) do
				P(m, V(0.7, 1.3, 0.7), CF(sx, 0.65, 0.3), DARK)
				Cyl(m, 0.5, 0.05, CF(sx, 0.55, 0.67) * CFrame.Angles(pi / 2, 0, 0), spec.acc, M.Neon)
			end
		elseif ex == "ringlight" then
			Ring(m, CF(monX, monTop + 1.7, -0.4), 1.5, 0.18, spec.acc, M.Neon, 18, "xy")
			P(m, V(0.12, 1.6, 0.12), CF(monX, monTop + 0.1, -0.5), DARK)
		elseif ex == "cube" then
			local c = P(m, V(1, 1, 1), CF(caseX - 0.2, 5.6, 0.2), spec.acc, M.Neon, { t = 0.2, name = "QuantumCube" })
			c:SetAttribute("SpinSpeed", 1.2)
			CollectionService:AddTag(c, "Spin")
			P(m, V(0.5, 0.5, 0.5), CF(caseX - 0.2, 5.6, 0.2), C(255, 255, 255), M.Neon, { name = "QuantumCore" })
		elseif ex == "holo" then
			local cf = CF(monX, monTop + 1.6, 0.6) * CFrame.Angles(rad(-8), 0, 0)
			P(m, V(3.6, 2.0, 0.04), cf, spec.acc, M.Neon, { t = 0.65 })
			P(m, V(3.6, 0.06, 0.06), cf * CF(0, 1.0, 0), spec.acc, M.Neon)
			P(m, V(3.6, 0.06, 0.06), cf * CF(0, -1.0, 0), spec.acc, M.Neon)
			for i = 1, 4 do P(m, V(2.4 - i * 0.4, 0.07, 0.05), cf * CF(-0.5, 0.7 - i * 0.28, 0.03), C(255, 255, 255), M.Neon, { t = 0.2 }) end
		elseif ex == "strip" then
			P(m, V(math.max(monW, 4) + 1, 0.06, 0.12), CF(monX, 0.03, 1.5), spec.acc, M.Neon)
		elseif ex == "orb" then
			local g = spinGroup(m, CF(-monW / 2 - 1.6, 3.2, 0.3), 1.6)
			Ball(g, 1.3, CF(-monW / 2 - 1.6, 3.2, 0.3), spec.acc, M.Neon, { t = 0.25 })
			Ring(g, CF(-monW / 2 - 1.6, 3.2, 0.3), 1.0, 0.07, C(255, 255, 255), M.Neon, 14, "xz")
		elseif ex == "dome" then
			Ball(m, 7, CF(0, 1.0, 0), spec.acc, M.Glass, { t = 0.9 })
			Ring(m, CF(0, 0.08, 0), 3.3, 0.1, spec.acc, M.Neon, 24, "xz")
		elseif ex == "rings" then
			local g = spinGroup(m, CF(caseX, 2.2, 0.2), 1.4)
			Ring(g, CF(caseX, 1.4, 0.2), 1.3, 0.1, spec.acc, M.Neon, 14, "xz")
			Ring(g, CF(caseX, 2.3, 0.2), 1.6, 0.1, C(255, 230, 160), M.Neon, 16, "xz")
			Ring(g, CF(caseX, 3.2, 0.2), 1.3, 0.1, spec.acc, M.Neon, 14, "xz")
		elseif ex == "portal" then
			local pc = CF(0, 4.0, -0.7)
			Ring(m, pc, 2.9, 0.28, spec.acc, M.Neon, 26, "xy", spec.rainbow and 0 or nil)
			Cyl(m, 5.6, 0.05, pc * CFrame.Angles(pi / 2, 0, 0), spec.acc, M.Neon, { t = 0.78 })
		elseif ex == "crown" then
			local g = spinGroup(m, CF(monX, monTop + 0.9, 0), 0.8)
			Ring(g, CF(monX, monTop + 0.9, 0), 1.0, 0.16, C(255, 215, 90), M.Neon, 14, "xz")
			for k = 0, 6 do
				local a = 2 * pi * k / 7
				P(g, V(0.18, 0.7, 0.18), CF(monX + cos(a), monTop + 1.25, sin(a)), C(255, 215, 90), M.Neon)
			end
		end
	end
end

function Models.Computer(tier, opts)
	opts = opts or {}
	local spec = Config.Computers[tier]
	local m = newModel("Computer" .. tier)
	local hasCase = spec.case ~= "none"
	local mons = spec.mons
	local totalW = 0
	for _, mon in ipairs(mons) do totalW = totalW + mon[1] + 0.15 end

	local lapAndMon = spec.lap and #mons > 0
	local monX = (lapAndMon and 2.4) or (hasCase and -0.7) or 0
	local limit = lapAndMon and 5.0 or (hasCase and 7.2 or 9.2)
	local k = (totalW > 0) and math.min(1, limit / totalW) or 1
	local caseX = 3.9
	local monTop, monW = 0, totalW * k

	if spec.lap then
		buildLaptop(m, spec, lapAndMon and -3.0 or 0, opts)
		monTop = 3.2
	end
	local x = monX - monW / 2
	for i, mon in ipairs(mons) do
		local w, h = mon[1] * k, mon[2] * k
		local top = buildMonitor(m, spec, x + w / 2, w, h, mon, i == 1 and not spec.lap, opts)
		monTop = math.max(monTop, top)
		x = x + w + 0.15 * k
	end
	if hasCase then buildCase(m, spec, caseX) end
	buildExtras(m, spec, monX, math.max(monW, 3), monTop, caseX, opts)
	m:SetAttribute("Tier", tier)
	return m
end

return Models
]]></ProtectedString></Properties></Item>
			<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config.lua  (ReplicatedStorage/Shared)
-- Single source of truth for every number, name and price in Scripting Simulator.
-- Used by the server (authoritative) and the client (display only).

local C = Color3.fromRGB
local Config = {}

----------------------------------------------------------------------
-- General
----------------------------------------------------------------------
Config.DATASTORE_NAME = "ScriptingSimulator_Data_v1"
Config.MAX_PLOTS = 16            -- set Game Settings > Max Players to 16 or less
Config.TICK = 0.5                -- income tick (seconds)
Config.AUTOSAVE = 45
Config.BASE_KEYS_PER_SEC = 2     -- typing speed of keyboard tier 1
Config.FOCUS_INTERVAL = 2        -- seconds of continuous typing per +1% "Focus" bonus
Config.FOCUS_MAX = 30            -- max Focus bonus in percent
Config.WORKER_RATIO = 0.5        -- a worker earns HALF of an equal player setup
Config.MAX_DECOR = 80            -- max placed decorations per house
Config.MAX_DECOR_OWNED = 25      -- max copies of one decoration that can be bought
Config.FLOOR_Y = 0.5             -- top of house floor (plot-local)
Config.SEAT_TOP = 1.6            -- seat height above floor
Config.DESK_TOP = 3.1            -- desk height above floor
Config.HARDCORE_MULT = 3.5       -- Hardcore mode: your own typing earns x3.5 ...
Config.HARDCORE_WINDOW = 15      -- ... and one solved challenge banks at most this many seconds of income
Config.TUTORIAL_STEPS = 9
Config.DEFAULT_SETTINGS = { musicVol = 0.5, sfxVol = 0.8, musicMuted = false, sfxMuted = false, hardcore = false }

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function nice(n, sig)
	sig = sig or 2
	if n <= 0 then return 0 end
	local mag = 10 ^ (math.floor(math.log10(n)) - (sig - 1))
	return math.floor(n / mag + 0.5) * mag
end

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local function trim(s)
	if s:find("%.") then
		s = s:gsub("0+$", "")
		s = s:gsub("%.$", "")
	end
	return s
end

function Config.format(n)
	n = tonumber(n) or 0
	if n ~= n then return "0" end
	if n < 1000 then
		if n < 100 then return trim(string.format("%.1f", n)) end
		return tostring(math.floor(n))
	end
	local i = math.min(math.floor(math.log10(n) / 3), #SUFFIX - 1)
	local v = n / 10 ^ (i * 3)
	local s
	if v < 10 then s = string.format("%.2f", v)
	elseif v < 100 then s = string.format("%.1f", v)
	else s = string.format("%.0f", v) end
	return trim(s) .. SUFFIX[i + 1]
end

function Config.formatMult(m) return "x" .. Config.format(m) end

----------------------------------------------------------------------
-- 20 Computers  (visual spec + generated multiplier / price)
-- mons: {width, height, curve=bool, crt=bool}   case: tower | mini | rack | core | none
----------------------------------------------------------------------
local COMP_PRICE_BASE, COMP_PRICE_GROWTH, COMP_MULT_GROWTH = 100, 3.8, 1.55

Config.Computers = {
	{ name = "Dusty Starter Laptop", lap = true, case = "none", body = C(188,182,165), acc = C(110,110,110), scr = C(80,220,120), mons = {}, ex = {}, code = 'print("hello")' },
	{ name = "Old Office Desktop", case = "tower", body = C(200,194,175), acc = C(150,150,140), scr = C(90,230,110), mons = { { 4.2, 3.2, crt = true } }, ex = {}, code = 'for i=1,10 do print(i) end' },
	{ name = "Budget Tower", case = "tower", body = C(45,47,52), acc = C(90,95,105), scr = C(70,150,255), mons = { { 4.6, 2.8 } }, ex = {}, code = 'local x = game.Workspace' },
	{ name = "Student Workstation", case = "tower", body = C(235,235,240), acc = C(255,150,60), scr = C(255,190,90), mons = { { 4.8, 2.9 } }, ex = { "speakers" }, code = 'part.Anchored = true' },
	{ name = "Coder's Notebook", lap = true, case = "none", body = C(170,176,186), acc = C(210,215,225), scr = C(120,190,255), mons = { { 3.4, 2.2 } }, ex = {}, code = 'function add(a,b) return a+b end' },
	{ name = "Gamer Rig", case = "tower", glass = true, rgb = C(255,50,70), body = C(20,20,26), acc = C(255,50,70), scr = C(255,90,110), mons = { { 5, 3 } }, ex = { "speakers" }, code = 'RunService.Heartbeat:Connect(update)' },
	{ name = "Dual-Monitor Dev Station", case = "tower", glass = true, rgb = C(60,170,255), body = C(30,34,44), acc = C(60,170,255), scr = C(90,200,255), mons = { { 4.2, 2.7 }, { 4.2, 2.7 } }, ex = {}, code = 'remote.OnServerEvent:Connect(f)' },
	{ name = "Silent Mini PC", case = "mini", body = C(240,242,245), acc = C(90,220,150), scr = C(120,240,170), mons = { { 5, 3 } }, ex = {}, code = 'task.spawn(function() end)' },
	{ name = "Neon Streamer PC", case = "tower", glass = true, rgb = C(255,60,200), body = C(25,18,34), acc = C(255,60,200), scr = C(255,120,230), mons = { { 5, 3 } }, ex = { "ringlight", "speakers" }, code = 'stream:Go(live)' },
	{ name = "Ultrawide Command Center", case = "tower", glass = true, rgb = C(170,90,255), body = C(22,18,36), acc = C(170,90,255), scr = C(190,140,255), mons = { { 8.6, 3, curve = true } }, ex = {}, code = 'TweenService:Create(ui, info, goal)' },
	{ name = "Liquid-Cooled Beast", case = "tower", glass = true, liquid = C(0,230,255), rgb = C(0,230,255), body = C(14,24,30), acc = C(0,230,255), scr = C(0,220,240), mons = { { 4.4, 2.8 }, { 4.4, 2.8 } }, ex = { "speakers" }, code = 'ds:UpdateAsync(key, cb)' },
	{ name = "Server Rack Terminal", case = "rack", body = C(36,38,44), acc = C(80,255,120), scr = C(80,255,120), mons = { { 5, 3 } }, ex = {}, code = '> deploy --prod' },
	{ name = "Quantum Dev Desk", case = "tower", glass = true, rgb = C(120,120,255), body = C(18,18,40), acc = C(120,120,255), scr = C(150,150,255), mons = { { 4, 2.6 }, { 4, 2.6 }, { 4, 2.6 } }, ex = { "cube" }, code = 'qubit:Entangle(other)' },
	{ name = "Holo-Display Workstation", case = "tower", glass = true, rgb = C(0,255,200), body = C(220,235,240), acc = C(0,255,200), scr = C(0,255,200), mons = { { 4.6, 2.8 } }, ex = { "holo" }, code = 'hologram.Project(scene)' },
	{ name = "Cyber Deck", case = "mini", body = C(30,10,40), acc = C(255,0,150), scr = C(255,0,150), mons = { { 5.4, 3, curve = true } }, ex = { "strip", "holo" }, code = 'neural.jack_in(net)' },
	{ name = "Orbital Mainframe", case = "rack", body = C(235,238,245), acc = C(255,210,80), scr = C(255,225,120), mons = { { 5.2, 3 } }, ex = { "orb" }, code = 'orbit.sync(satellites)' },
	{ name = "Neural Interface Rig", case = "mini", body = C(20,30,36), acc = C(90,255,190), scr = C(90,255,190), mons = { { 5.6, 3.2, curve = true } }, ex = { "dome" }, code = 'brain.think(code)' },
	{ name = "Plasma Core Supercomputer", case = "core", body = C(40,20,14), acc = C(255,130,30), scr = C(255,160,60), mons = { { 4.2, 2.8 }, { 4.2, 2.8 }, { 4.2, 2.8 } }, ex = { "rings" }, code = 'core.ignite(plasma)' },
	{ name = "Dimensional Console", case = "core", body = C(20,10,50), acc = C(190,100,255), scr = C(210,150,255), mons = { { 6.2, 3.4, curve = true } }, ex = { "portal" }, code = 'rift.open(dimension)' },
	{ name = "The Infinite Machine", case = "core", body = C(255,240,200), acc = C(255,215,90), scr = C(255,255,255), mons = { { 4.6, 3 }, { 4.6, 3 }, { 4.6, 3 } }, ex = { "portal", "crown", "orb", "holo", "strip" }, rainbow = true, code = 'while true do bits = bits + inf end' },
}
for i, c in ipairs(Config.Computers) do
	c.tier = i
	c.mult = nice(COMP_MULT_GROWTH ^ (i - 1))
	c.price = (i == 1) and 0 or nice(COMP_PRICE_BASE * COMP_PRICE_GROWTH ^ (i - 2))
end

----------------------------------------------------------------------
-- 20 Keyboards   (speed = typing-speed multiplier)
----------------------------------------------------------------------
local KB_PRICE_BASE, KB_PRICE_GROWTH, KB_SPEED_GROWTH = 60, 3.7, 1.5

Config.Keyboards = {
	{ name = "Squeaky Membrane", layout = "full", case = C(120,122,128), key = C(200,200,205), ex = {} },
