-- r = footprint radius used for bounds checks
----------------------------------------------------------------------
Config.Decor = {
	{ id = "fern", name = "Potted Fern", price = 60, cat = "Inside", mount = "floor", r = 1.3, icon = "🪴" },
	{ id = "palm", name = "Tall Palm", price = 220, cat = "Inside", mount = "floor", r = 1.8, icon = "🌴" },
