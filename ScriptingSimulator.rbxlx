			<Item class="LocalScript" referent="RBX45"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main.client.lua : wires the client together.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local player = Players.LocalPlayer
local Modules = script.Parent:WaitForChild("ClientModules")
local Store = require(Modules.Store)
local HUD = require(Modules.HUD)
local Menus = require(Modules.Menus)
local Effects = require(Modules.Effects)
local Animator = require(Modules.Animator)
local Placement = require(Modules.PlacementUI)
local Sfx = require(Modules.Sfx)
local Music = require(Modules.Music)
local Tutorial = require(Modules.Tutorial)
local HardcoreUI = require(Modules.HardcoreUI)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local root = HUD.init()
Store.toast = HUD.toast
Menus.init(root)
Placement.init(root)
Tutorial.init(root)
HardcoreUI.init(root, function() return Menus.isOpen() or Placement.isActive() end)

Placement.onActive = function(active) HUD.setSettingsVisible(not active) end
Menus.onPlace = function(id) Placement.start(id) end
Menus.onOpened = function(key) Sfx.play("open"); Tutorial.menuOpened(key) end
Menus.onClosed = function() Sfx.play("close") end

Effects.start()
Animator.start()
Sfx.start()
Music.start()

local firstState = true
Remotes.State.OnClientEvent:Connect(function(state)
	Store.setState(state)
	if firstState then   -- saved settings are now loaded
		firstState = false
		Sfx.apply(); Music.apply()
		Tutorial.start()
	end
end)

Remotes.Notify.OnClientEvent:Connect(function(kind, text, fx, snd)
	HUD.toast(kind, text)
	Sfx.play(snd or ((kind == "success") and "purchase") or ((kind == "error") and "error") or nil)
	if fx then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then Effects.burst(hrp.Position + Vector3.new(0, 2, 0)) end
	end
end)

local lastTick = 0
Remotes.Income.OnClientEvent:Connect(function(amount, pos, isWorker)
	Effects.floatBits(amount, pos, isWorker)
	local now = os.clock()
	if now - lastTick > 0.35 then
		lastTick = now
		Sfx.play(isWorker and "workerTick" or "tick")
	end
end)

-- everything in the world is opened by tapping a prompt: shop counters, the signs beside your house, portals, your chair
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local owner = prompt:GetAttribute("OwnerId")
	if owner and owner ~= player.UserId then
		HUD.toast("error", "That's someone else's house!")
		return
	end
	local menu, tp = prompt:GetAttribute("Menu"), prompt:GetAttribute("Teleport")
	if menu then
		Menus.open(menu)
	elseif tp then
		Sfx.play("portal")
		Store.act("Teleport", tp)
	elseif prompt:GetAttribute("Action") == "Sit" then
		Store.act("ToggleTyping")
	end
end)

-- fetch the initial state (the server also pushes it once it has loaded your data)
task.spawn(function()
	while not Store.state do
		local ok, res, st = pcall(function() return Remotes.Action:InvokeServer("GetState") end)
		if ok and res == true and type(st) == "table" then
			Store.setState(st)
			if firstState then firstState = false; Sfx.apply(); Music.apply(); Tutorial.start() end
			break
		end
		task.wait(1)
	end
end)
]]></ProtectedString></Properties></Item>
