----------------------------------------------------------------------
Config.MAX_WORKERS = 8
Config.WorkerPrice = {}
for i = 1, Config.MAX_WORKERS do Config.WorkerPrice[i] = nice(5000 * 13 ^ (i - 1)) end
Config.WorkerNames = { "Ada", "Linus", "Grace", "Alan", "Margaret", "Dennis", "Hedy", "Tim" }
Config.WorkerStyles = {
