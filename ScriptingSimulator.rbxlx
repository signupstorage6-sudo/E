	{ id = "coffee_table", name = "Coffee Table", price = 250, cat = "Inside", mount = "floor", r = 2.2, icon = "☕" },
	{ id = "tv_stand", name = "TV & Stand", price = 900, cat = "Inside", mount = "floor", r = 3.4, icon = "📺" },
	{ id = "floor_lamp", name = "Floor Lamp", price = 150, cat = "Inside", mount = "floor", r = 1, icon = "💡" },
	{ id = "bookshelf", name = "Bookshelf", price = 480, cat = "Inside", mount = "floor", r = 2.8, icon = "📚" },
	{ id = "rug_round", name = "Round Rug", price = 200, cat = "Inside", mount = "floor", r = 4.5, icon = "⭕" },
	{ id = "rug_rect", name = "Striped Rug", price = 260, cat = "Inside", mount = "floor", r = 5, icon = "🟦" },
	{ id = "fridge", name = "Mini Fridge", price = 420, cat = "Inside", mount = "floor", r = 1.6, icon = "🧊" },
	{ id = "beanbag", name = "Gaming Beanbag", price = 180, cat = "Inside", mount = "floor", r = 2, icon = "🟣" },
	{ id = "aquarium", name = "Aquarium", price = 1200, cat = "Inside", mount = "floor", r = 2.8, icon = "🐠" },
	{ id = "side_desk", name = "Side Desk", price = 320, cat = "Inside", mount = "floor", r = 2.8, icon = "🪑" },
	{ id = "arcade", name = "Arcade Cabinet", price = 2500, cat = "Inside", mount = "floor", r = 2, icon = "🕹" },
	{ id = "trophy", name = "Trophy Pedestal", price = 1800, cat = "Inside", mount = "floor", r = 1.3, icon = "🏆" },
	{ id = "poster", name = "Framed Poster", price = 90, cat = "Inside", mount = "wall", r = 2, icon = "🖼" },
	{ id = "clock", name = "Wall Clock", price = 120, cat = "Inside", mount = "wall", r = 1.4, icon = "🕒" },
	{ id = "wall_shelf", name = "Floating Shelf", price = 200, cat = "Inside", mount = "wall", r = 2.5, icon = "📖" },
	{ id = "neon_sign", name = "Neon </> Sign", price = 700, cat = "Inside", mount = "wall", r = 2.5, icon = "✨" },
	{ id = "wall_tv", name = "Wall TV", price = 1100, cat = "Inside", mount = "wall", r = 3, icon = "📺" },
	{ id = "bush", name = "Garden Bush", price = 80, cat = "Outside", mount = "floor", r = 2, icon = "🌿" },
	{ id = "tree", name = "Oak Tree", price = 400, cat = "Outside", mount = "floor", r = 3.4, icon = "🌳" },
	{ id = "flowers", name = "Flower Bed", price = 150, cat = "Outside", mount = "floor", r = 3, icon = "🌷" },
	{ id = "gnome", name = "Garden Gnome", price = 250, cat = "Outside", mount = "floor", r = 1, icon = "🧙" },
	{ id = "fountain", name = "Stone Fountain", price = 2200, cat = "Outside", mount = "floor", r = 4.5, icon = "⛲" },
	{ id = "bench", name = "Garden Bench", price = 300, cat = "Outside", mount = "floor", r = 3, icon = "🪵" },
	{ id = "lamp_post", name = "Lantern Post", price = 260, cat = "Outside", mount = "floor", r = 1, icon = "🏮" },
	{ id = "mailbox", name = "Mailbox", price = 90, cat = "Outside", mount = "floor", r = 1, icon = "📬" },
	{ id = "bbq", name = "BBQ Grill", price = 500, cat = "Outside", mount = "floor", r = 2, icon = "🍖" },
	{ id = "picnic", name = "Picnic Table", price = 700, cat = "Outside", mount = "floor", r = 4, icon = "🧺" },
}
Config.DecorById = {}
for _, d in ipairs(Config.Decor) do Config.DecorById[d.id] = d end

----------------------------------------------------------------------
-- Income math (server uses it for payouts; client for display only)
----------------------------------------------------------------------
function Config.incomeFor(compTier, kbTier, houseLevel)
	return Config.BASE_KEYS_PER_SEC * Config.Keyboards[kbTier].speed * Config.Computers[compTier].mult * Config.House[houseLevel].mult
end

-- Workers always use equipment ONE tier below the player's equipped gear (never below tier 1).
function Config.workerTiers(compEq, kbEq)
	return math.max(1, compEq - 1), math.max(1, kbEq - 1)
end

-- Each worker earns WORKER_RATIO (= half) of what a player setup with that gear would earn.
function Config.workerIncome(compEq, kbEq, houseLevel)
	local wc, wk = Config.workerTiers(compEq, kbEq)
	return Config.incomeFor(wc, wk, houseLevel) * Config.WORKER_RATIO
end

return Config
