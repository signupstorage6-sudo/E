	{ name = "Dimensional Keys", layout = "split", case = C(10,10,30), key = C(30,10,60), glow = "rainbow", float = true, ex = { "wrist" } },
	{ name = "The Infinity Board", layout = "full", case = C(255,215,90), key = C(255,245,215), glow = "rainbow", float = true, glass = true, ex = { "wrist" } },
