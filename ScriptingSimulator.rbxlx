for i, k in ipairs(Config.Keyboards) do
	k.tier = i
	k.speed = nice(KB_SPEED_GROWTH ^ (i - 1))
	k.price = (i == 1) and 0 or nice(KB_PRICE_BASE * KB_PRICE_GROWTH ^ (i - 2))
end

----------------------------------------------------------------------
-- House upgrades  (level 1 = start).  mult is a multiplier on the whole setup.
----------------------------------------------------------------------
local HOUSE_NAMES = { "Rusty Shack", "Tidy Cabin", "Cozy Home", "Dev Den", "Garden House", "Tech Loft", "Solar Studio", "RGB Mansion", "Signal Tower", "Scripting HQ" }
local HOUSE_MULT = { 1, 1.25, 1.6, 2.1, 2.8, 3.8, 5.2, 7.5, 11, 16 }
